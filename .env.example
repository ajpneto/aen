# ==============================================================================
# AENTECH — Modelo de Configuração (.env.example)
# Copie este arquivo para .env e preencha suas configurações de produção.
# ==============================================================================

# --- Segurança e Autenticação (JWT) ---
# Gere uma chave forte, por exemplo com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=sua-chave-secreta-forte-e-aleatoria-aqui
JWT_EXPIRES_SECONDS=86400

# --- Usuário Administrador Inicial (Bootstrap no primeiro acesso) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=senha_segura_aqui
ADMIN_EMAIL=admin@seudominio.com

# --- Banco de Dados ---
# Padrão local: sqlite:///aentech.db
# No PythonAnywhere: sqlite:////home/<seu_usuario>/<pasta>/aentech.db
# Para PostgreSQL: postgresql://usuario:senha@host:5432/nome_banco
DATABASE_URL=sqlite:///aentech.db

# --- Negócio e Atendimento ao Cliente ---
BUSINESS_NAME=AENTECH
BUSINESS_SLOGAN=Assistência Técnica Especializada em Celulares e Tablets
BUSINESS_CITY=Ourinhos - SP
BUSINESS_ADDRESS=Rua João Rafael, Nº 383, Jardim Industrial, Ourinhos - SP
BUSINESS_EMAIL=contato@fazhoje.com
BUSINESS_PHONE=(41) 98451-2660
WHATSAPP_NUMBER=5541984512660
WHATSAPP_DISPLAY=(41) 98451-2660
WHATSAPP_LINK=https://wa.me/5541984512660
BUSINESS_HORARIO=Seg a Sáb — 09h às 19h
BUSINESS_GARANTIA_DIAS=90

# --- Notificações por E-mail via SMTP ---
MAIL_ENABLED=True
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=seu_email@gmail.com
MAIL_PASSWORD=sua_senha_de_aplicativo_gmail
MAIL_DEFAULT_SENDER=AENTECH Assistência Técnica <seu_email@gmail.com>

# --- Servidor Flask ---
FLASK_ENV=production
FLASK_DEBUG=False
PORT=5000
